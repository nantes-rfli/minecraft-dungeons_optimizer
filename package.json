{
  "name": "minecraft-dungeons-optimizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "audit:dps": "node scripts/audit-dps-regression.ts",
    "audit:damage-events": "node scripts/audit-damage-events.ts",
    "audit:enchants": "node scripts/audit-melee-enchantments.ts",
    "audit:melee": "node scripts/audit-melee-attack-profiles.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:temporal-enchants": "node scripts/audit-temporal-enchantments.ts",
    "audit:soul": "node scripts/audit-soul-subsystem.ts",
    "audit:dot-damage": "node scripts/audit-dot-damage.ts",
    "audit:cc": "node scripts/audit-cc-subsystem.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "^10.0.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "^24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.3.0",
    "typescript": "~5.9.2",
    "react-server-dom-webpack": "19.2.6",
    "typescript-eslint": "^8.68.0",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.0.17",
    "wrangler": "4.92.0"
  }
